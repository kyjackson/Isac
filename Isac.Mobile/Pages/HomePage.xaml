<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Isac.Mobile.Pages.HomePage"
             Title="ISAC Home">
    <VerticalStackLayout Padding="24" Spacing="16">
        <Label Text="ISAC Companion" FontSize="24"/>
        <Entry x:Name="BaseUrlEntry" Placeholder="API Base URL (https://...)" />
        <Button Text="Test Connection" Clicked="OnTestConnection" />
        <Label x:Name="ResultLabel" TextColor="Gray"/>
    </VerticalStackLayout>
</ContentPage>