<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Isac.Mobile.Pages.EnrollmentPage"
             Title="Voice Enrollment">
    <VerticalStackLayout Padding="24" Spacing="16">
        <Label Text="Record 3-5 short clips for your voice profile." />
        <Button Text="Record Clip" Clicked="OnRecordClicked" />
        <Button Text="Upload Clips" Clicked="OnUploadClicked" />
        <Label x:Name="StatusLabel" TextColor="Gray"/>
    </VerticalStackLayout>
</ContentPage>