<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!-- Splash shows first, then switches to Maui.MainTheme -->
	<style name="Maui.SplashTheme" parent="Theme.SplashScreen">
		<item name="windowSplashScreenAnimatedIcon">@mipmap/appicon</item>
		<item name="android:windowSplashScreenBackground">@color/colorPrimary</item>
		<item name="postSplashScreenTheme">@style/Maui.MainTheme</item>
	</style>

	<!-- Main app theme must be Material-based -->
	<style name="Maui.MainTheme" parent="Theme.Material3.DayNight.NoActionBar">
		<item name="android:statusBarColor">@android:color/transparent</item>
		<item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
	</style>
</resources>