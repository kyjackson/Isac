<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Isac.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Isac.Mobile.Pages"
    Title="Isac.Mobile">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate pages:HomePage}"
            Route="Home" />

        <ShellContent
            Title="Enroll"
            ContentTemplate="{DataTemplate pages:EnrollmentPage}"
            Route="Enrollment" />

        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate pages:SettingsPage}"
            Route="Settings" />
    </TabBar>

</Shell>
